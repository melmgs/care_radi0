{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "care-radi0",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/itunes/*",
      "/deezer/*",
      "/api/*",
      "/admin/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB"
    }
  ]
}
